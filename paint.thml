<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>クラシック・ペイント (Classic Paint)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (M PLUS Rounded 1c / Monospace) -->
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'M PLUS Rounded 1c', 'MS Sans Serif', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            background-color: #808080;
        }
        
        /* Windows 95風 3D立体ベベル効果の再現 */
        .win-outset {
            border: 2px solid;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            border-right-color: #808080;
            border-bottom-color: #808080;
            box-shadow: 1px 1px 0px 0px #000000;
        }
        
        .win-inset {
            border: 2px solid;
            border-top-color: #808080;
            border-left-color: #808080;
            border-right-color: #ffffff;
            border-bottom-color: #ffffff;
        }

        .win-button-active {
            border: 2px solid;
            border-top-color: #000000;
            border-left-color: #000000;
            border-right-color: #ffffff;
            border-bottom-color: #ffffff;
            background-color: #e0e0e0;
            padding-top: 2px;
            padding-left: 2px;
        }

        /* スライダーのつまみのカスタマイズ（レトロな四角形に） */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            background: #808080;
            height: 4px;
            border: 1px solid #fff;
            border-bottom-color: #fff;
            border-right-color: #fff;
            border-top-color: #404040;
            border-left-color: #404040;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 10px;
            height: 16px;
            background: #f1f1f1;
            border: 1px solid;
            border-top-color: #fff;
            border-left-color: #fff;
            border-right-color: #404040;
            border-bottom-color: #404040;
            cursor: pointer;
        }

        /* スクロールバーのレトロスタイル */
        ::-webkit-scrollbar {
            width: 16px;
            height: 16px;
            background-color: #c0c0c0;
        }
        ::-webkit-scrollbar-thumb {
            background-color: #f1f1f1;
            border: 2px solid;
            border-top-color: #fff;
            border-left-color: #fff;
            border-right-color: #808080;
            border-bottom-color: #808080;
        }
        ::-webkit-scrollbar-button {
            display: block;
            background-color: #f1f1f1;
            width: 16px;
            height: 16px;
            border: 1px solid;
            border-top-color: #fff;
            border-left-color: #fff;
            border-right-color: #808080;
            border-bottom-color: #808080;
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden text-black text-xs bg-[#808080]">

    <!-- Windowsクラシック風タイトルバー -->
    <header class="bg-[#000080] text-white px-2 py-1 flex justify-between items-center shrink-0 select-none">
        <div class="flex items-center gap-1.5 font-bold tracking-wide">
            <i data-lucide="palette" class="w-4 h-4 text-amber-300"></i>
            <span>ペイント - paint.exe</span>
        </div>
        <div class="flex gap-1">
            <button class="w-4 h-4 bg-[#f1f1f1] text-black font-bold flex items-center justify-center win-outset text-[10px] active:scale-95">_</button>
            <button class="w-4 h-4 bg-[#f1f1f1] text-black font-bold flex items-center justify-center win-outset text-[10px] active:scale-95">▢</button>
            <button class="w-4 h-4 bg-[#f1f1f1] text-black font-bold flex items-center justify-center win-outset text-[10px] active:scale-95 hover:bg-rose-500 hover:text-white">×</button>
        </div>
    </header>

    <!-- 超簡易メニューバー（ファイル保存や全クリアをコンパクトに格納） -->
    <nav class="bg-[#f1f1f1] px-2 py-1 flex items-center justify-between border-b border-[#808080] shrink-0 text-[11px] shadow-[inset_0_1px_0_#fff] select-none">
        <div class="flex gap-4">
            <button id="btnNew" class="hover:bg-[#000080] hover:text-white px-2 py-0.5 rounded transition cursor-pointer" title="新規キャンバス (全消去)">新規作成(N)</button>
            <label class="hover:bg-[#000080] hover:text-white px-2 py-0.5 rounded transition cursor-pointer">
                開く(O)...
                <input type="file" id="imageLoader" accept="image/*" class="hidden">
            </label>
            <button id="btnSave" class="hover:bg-[#000080] hover:text-white px-2 py-0.5 rounded transition cursor-pointer" title="PNG形式で保存">保存(S)</button>
            <button id="btnUndo" class="hover:bg-[#000080] hover:text-white px-2 py-0.5 rounded transition cursor-pointer disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-black" disabled>元に戻す(U)</button>
        </div>
        <div class="text-[10px] text-zinc-500 font-mono">Ver 1.0 (Simple Edition)</div>
    </nav>

    <!-- メインワークスペース -->
    <main class="flex-1 flex overflow-hidden">

        <!-- 左側極小ツールボックス (幅 52px 固定でキャンバス幅を最大化) -->
        <section class="w-[52px] bg-[#f1f1f1] border-r-2 border-[#808080] p-1 flex flex-col items-center gap-2 select-none shrink-0 shadow-[inset_-1px_0_0_#fff]">
            
            <!-- 描画ツール群 (グリッドで超コンパクトに配置) -->
            <div class="grid grid-cols-2 gap-0.5 w-full" id="toolGroup">
                <!-- 鉛筆 -->
                <button data-tool="pencil" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-outset group" title="鉛筆で描く">
                    <i data-lucide="pencil" class="w-3.5 h-3.5 text-zinc-700"></i>
                </button>
                <!-- ブラシ (初期選択) -->
                <button data-tool="brush" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-button-active group" title="ブラシで描く">
                    <i data-lucide="brush" class="w-3.5 h-3.5 text-blue-800 font-bold"></i>
                </button>
                <!-- 消しゴム -->
                <button data-tool="eraser" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-outset group" title="消しゴム">
                    <i data-lucide="eraser" class="w-3.5 h-3.5 text-rose-600"></i>
                </button>
                <!-- バケツ（塗りつぶし） -->
                <button data-tool="bucket" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-outset group" title="塗りつぶし">
                    <i data-lucide="paint-bucket" class="w-3.5 h-3.5 text-amber-600"></i>
                </button>
                <!-- 直線 -->
                <button data-tool="line" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-outset group" title="直線を引く">
                    <i data-lucide="minus" class="w-3.5 h-3.5 text-zinc-700 rotate-45"></i>
                </button>
                <!-- 四角形 -->
                <button data-tool="rect" class="tool-btn w-5 h-5 bg-[#f1f1f1] flex items-center justify-center win-outset group" title="四角形を描く">
                    <i data-lucide="square" class="w-3.5 h-3.5 text-zinc-700"></i>
                </button>
            </div>

            <!-- 太さ選択パネル (Windowsペイントでお馴染みのクラシックなボックス) -->
            <div class="w-full mt-2 border-2 border-t-[#808080] border-l-[#808080] border-b-white border-r-white bg-[#f1f1f1] p-1 flex flex-col items-center gap-1.5" title="線の太さ">
                <span class="text-[9px] font-bold text-zinc-600 scale-90">太さ</span>
                
                <!-- クリック選択式のプリセットリスト -->
                <div class="flex flex-col gap-1 w-full" id="sizePresets">
                    <button data-size="2" class="size-btn w-full h-3 flex items-center justify-center hover:bg-[#000080]/10 border border-transparent rounded">
                        <div class="w-4 h-[1px] bg-black"></div>
                    </button>
                    <button data-size="5" class="size-btn w-full h-3 flex items-center justify-center hover:bg-[#000080]/10 border border-transparent rounded">
                        <div class="w-4 h-[3px] bg-black"></div>
                    </button>
                    <button data-size="10" class="size-btn w-full h-3 flex items-center justify-center hover:bg-[#000080]/10 border border-blue-600 bg-white rounded">
                        <div class="w-4 h-[5px] bg-black"></div>
                    </button>
                    <button data-size="20" class="size-btn w-full h-4 flex items-center justify-center hover:bg-[#000080]/10 border border-transparent rounded">
                        <div class="w-4 h-[8px] bg-black"></div>
                    </button>
                    <button data-size="40" class="size-btn w-full h-5 flex items-center justify-center hover:bg-[#000080]/10 border border-transparent rounded">
                        <div class="w-4 h-[12px] bg-black"></div>
                    </button>
                </div>

                <!-- スライダーでもっと細かく調整可能 -->
                <div class="w-full mt-1 flex flex-col items-center">
                    <input type="range" id="brushSize" min="1" max="100" value="10" class="w-full cursor-pointer" title="スライダーで無段階調整">
                    <span id="brushSizeVal" class="text-[9px] font-mono mt-0.5 text-blue-800 font-bold">10px</span>
                </div>
            </div>

            <!-- 消しゴムやペン先のリアルタイム円プレビュー -->
            <div class="w-8 h-8 win-inset bg-white flex items-center justify-center overflow-hidden" title="現在のペン先プレビュー">
                <div id="brushPreview" class="bg-black rounded-full" style="width: 10px; height: 10px;"></div>
            </div>

        </section>

        <!-- キャンバス描画メインエリア (グレーのデスクトップ背景風) -->
        <section class="flex-1 bg-[#808080] p-2 overflow-auto relative flex items-start justify-start">
            <div class="win-inset bg-white shrink-0 relative m-auto shadow-md">
                <!-- 描画用キャンバス -->
                <canvas id="paintCanvas" class="block bg-white cursor-crosshair"></canvas>
            </div>
        </section>

    </main>

    <!-- 下部カラーパレット & RGBコントロールバー (非常に薄く設計) -->
    <footer class="bg-[#f1f1f1] border-t-2 border-[#808080] p-1.5 flex flex-wrap items-center gap-3 shrink-0 select-none shadow-[inset_0_1px_0_#fff]">
        
        <!-- 現在の選択色 (重なり合うペイント風インジケータ) -->
        <div class="flex items-center gap-1 shrink-0">
            <div class="relative w-9 h-9 win-inset bg-zinc-300 flex items-center justify-center">
                <!-- メイン色 -->
                <div id="colorIndicator" class="w-6 h-6 win-outset relative cursor-pointer" style="background-color: #000000;" title="クリックしてカラーピッカーを開く">
                    <!-- 非表示のネイティブカラーピッカー -->
                    <input type="color" id="nativeColorPicker" value="#000000" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                </div>
            </div>
            <div class="flex flex-col text-[10px]">
                <span class="font-bold text-zinc-600">カラー</span>
                <span id="hexCode" class="font-mono text-blue-900 font-semibold">#000000</span>
            </div>
        </div>

        <!-- プリセットカラーパレット (Windows風のパレット並び) -->
        <div class="grid grid-rows-2 grid-flow-col gap-0.5 border border-zinc-400 p-0.5 bg-zinc-200" id="presetPalette">
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #000000;" data-color="#000000" title="黒"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #808080;" data-color="#808080" title="灰色"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #800000;" data-color="#800000" title="暗い赤"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #ff0000;" data-color="#ff0000" title="赤"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #808000;" data-color="#808000" title="オリーブ"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #ffff00;" data-color="#ffff00" title="黄色"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #008000;" data-color="#008000" title="緑"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #00ff00;" data-color="#00ff00" title="黄緑"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #008080;" data-color="#008080" title="ティール"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #00ffff;" data-color="#00ffff" title="水色"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #000080;" data-color="#000080" title="ネイビー"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #0000ff;" data-color="#0000ff" title="青"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #800080;" data-color="#800080" title="紫"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #ff00ff;" data-color="#ff00ff" title="マゼンタ"></button>
            
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #ffffff;" data-color="#ffffff" title="白"></button>
            <button class="w-3.5 h-3.5 border border-zinc-500 hover:scale-110 active:scale-90" style="background-color: #c0c0c0;" data-color="#c0c0c0" title="薄い灰色"></button>
        </div>

        <!-- RGB 個別調色スライダー (超コンパクト設計) -->
        <div class="flex items-center gap-3 border-l border-zinc-400 pl-3 flex-1 min-w-[200px]">
            <div class="flex flex-col w-full gap-1">
                <!-- R スライダー -->
                <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold text-red-600 w-3">R</span>
                    <input type="range" id="redSlider" min="0" max="255" value="0" class="flex-1 cursor-pointer">
                    <span id="rVal" class="text-[9px] font-mono text-zinc-600 w-5 text-right">0</span>
                </div>
                <!-- G スライダー -->
                <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold text-emerald-600 w-3">G</span>
                    <input type="range" id="greenSlider" min="0" max="255" value="0" class="flex-1 cursor-pointer">
                    <span id="gVal" class="text-[9px] font-mono text-zinc-600 w-5 text-right">0</span>
                </div>
                <!-- B スライダー -->
                <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-bold text-blue-600 w-3">B</span>
                    <input type="range" id="blueSlider" min="0" max="255" value="0" class="flex-1 cursor-pointer">
                    <span id="bVal" class="text-[9px] font-mono text-zinc-600 w-5 text-right">0</span>
                </div>
            </div>
        </div>

        <!-- 右端ステータス表示 (座標 & サイズ) -->
        <div class="hidden md:flex items-center gap-3 border-l border-zinc-400 pl-3 text-[10px] text-zinc-600 font-mono shrink-0">
            <span class="flex items-center gap-1">
                <i data-lucide="mouse-pointer-2" class="w-3 h-3"></i>
                <span id="coords">0, 0px</span>
            </span>
            <span class="flex items-center gap-1">
                <i data-lucide="expand" class="w-3 h-3"></i>
                <span id="resolution">800x600</span>
            </span>
        </div>

    </footer>

    <script>
        // Lucide アイコン初期化
        lucide.createIcons();

        // DOM要素の取得
        const canvas = document.getElementById('paintCanvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        
        const toolButtons = document.querySelectorAll('.tool-btn');
        const sizeButtons = document.querySelectorAll('.size-btn');
        const brushSizeInput = document.getElementById('brushSize');
        const brushSizeVal = document.getElementById('brushSizeVal');
        const brushPreview = document.getElementById('brushPreview');

        // RGB関連
        const redSlider = document.getElementById('redSlider');
        const greenSlider = document.getElementById('greenSlider');
        const blueSlider = document.getElementById('blueSlider');
        const rVal = document.getElementById('rVal');
        const gVal = document.getElementById('gVal');
        const bVal = document.getElementById('bVal');
        const colorIndicator = document.getElementById('colorIndicator');
        const hexCode = document.getElementById('hexCode');
        const nativeColorPicker = document.getElementById('nativeColorPicker');
        const presetPalette = document.getElementById('presetPalette');

        // アクション
        const btnNew = document.getElementById('btnNew');
        const btnSave = document.getElementById('btnSave');
        const btnUndo = document.getElementById('btnUndo');
        const imageLoader = document.getElementById('imageLoader');

        // ステータス表示
        const coordsDisplay = document.getElementById('coords');
        const resolutionDisplay = document.getElementById('resolution');

        // アプリケーション状態
        let isDrawing = false;
        let currentTool = 'brush'; // pencil, brush, eraser, bucket, line, rect
        let penColor = { r: 0, g: 0, b: 0 }; // 初期カラーは黒
        let penSize = 10;
        let startX = 0;
        let startY = 0;
        let snapshot = null; // 図形描画時の一時保存用

        // シンプルなUndo用履歴スタック (メモリに優しい最大15件)
        const undoStack = [];
        const MAX_HISTORY = 15;

        // 履歴の保存
        function saveToHistory() {
            const state = ctx.getImageData(0, 0, canvas.width, canvas.height);
            undoStack.push(state);
            if (undoStack.length > MAX_HISTORY) {
                undoStack.shift();
            }
            btnUndo.disabled = false;
        }

        // 元に戻す (Undo)
        function handleUndo() {
            if (undoStack.length === 0) return;
            const previousState = undoStack.pop();
            ctx.putImageData(previousState, 0, 0);
            if (undoStack.length === 0) {
                btnUndo.disabled = true;
            }
        }

        // キャンバスのサイズ初期化
        function initCanvas() {
            // UIを小さくした分、描画エリアを広くとる
            const width = Math.min(window.innerWidth - 80, 800);
            const height = Math.min(window.innerHeight - 150, 500);
            
            canvas.width = width;
            canvas.height = height;

            // 初期化時に全体を白色で塗りつぶす
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // 解像度ステータスの表示
            resolutionDisplay.textContent = `${canvas.width} x ${canvas.height}px`;
            
            undoStack.length = 0;
            btnUndo.disabled = true;
        }

        // RGBカラー値の同期更新
        function updateColorFromRGB() {
            const r = parseInt(redSlider.value);
            const g = parseInt(greenSlider.value);
            const b = parseInt(blueSlider.value);
            penColor = { r, g, b };

            // 数値テキストの反映
            rVal.textContent = r;
            gVal.textContent = g;
            bVal.textContent = b;

            // HEX16進数の生成
            const hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase();
            hexCode.textContent = hex;
            
            // 色プレビューに反映
            colorIndicator.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
            nativeColorPicker.value = hex;

            // ブラシ先プレビューの色も同期（消しゴム以外のとき）
            if (currentTool !== 'eraser') {
                brushPreview.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
            }
        }

        // 16進数(#000000など)からRGBへ変換してスライダーにセット
        function setColorFromHex(hex) {
            const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
            const fullHex = hex.replace(shorthandRegex, (m, r, g, b) => r + r + g + g + b + b);
            
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(fullHex);
            if (result) {
                redSlider.value = parseInt(result[1], 16);
                greenSlider.value = parseInt(result[2], 16);
                blueSlider.value = parseInt(result[3], 16);
                updateColorFromRGB();
            }
        }

        // 各RGBスライダーのイベントリスナー
        [redSlider, greenSlider, blueSlider].forEach(slider => {
            slider.addEventListener('input', updateColorFromRGB);
        });

        // システムカラーピッカー連動
        nativeColorPicker.addEventListener('input', (e) => {
            setColorFromHex(e.target.value);
        });

        // プリセットパレットからの色選択
        presetPalette.addEventListener('click', (e) => {
            const target = e.target.closest('button');
            if (target) {
                const hexColor = target.getAttribute('data-color');
                setColorFromHex(hexColor);
            }
        });

        // ブラシ太さの適用
        function setBrushSize(size) {
            penSize = size;
            brushSizeInput.value = size;
            brushSizeVal.textContent = `${size}px`;
            
            // 円プレビューの更新
            brushPreview.style.width = `${Math.max(2, size)}px`;
            brushPreview.style.height = `${Math.max(2, size)}px`;
        }

        // 線の太さスライダーのイベント
        brushSizeInput.addEventListener('input', (e) => {
            setBrushSize(e.target.value);
        });

        // 太さ選択ボックス（プリセット）のクリックイベント
        sizeButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                // ボーダーのアクティブ化表示切り替え
                sizeButtons.forEach(b => {
                    b.classList.remove('border-blue-600', 'bg-white');
                    b.classList.add('border-transparent');
                });
                btn.classList.add('border-blue-600', 'bg-white');
                btn.classList.remove('border-transparent');

                const size = parseInt(btn.getAttribute('data-size'));
                setBrushSize(size);
            });
        });

        // 描画ツールの切り替え
        toolButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                // ツールボタンのアクティブ表示切替 (クラシック風の凹み表現)
                toolButtons.forEach(b => {
                    b.classList.remove('win-button-active');
                    b.classList.add('win-outset');
                });
                btn.classList.add('win-button-active');
                btn.classList.remove('win-outset');

                currentTool = btn.getAttribute('data-tool');
                
                // 消しゴムのときはプレビューを白（背景と同色）にする
                if (currentTool === 'eraser') {
                    brushPreview.style.backgroundColor = '#ffffff';
                    brushPreview.classList.add('border', 'border-zinc-300');
                } else {
                    brushPreview.style.backgroundColor = `rgb(${penColor.r}, ${penColor.g}, ${penColor.b})`;
                    brushPreview.classList.remove('border', 'border-zinc-300');
                }
            });
        });

        // バケツ塗りつぶし (Flood Fillアルゴリズム)
        function floodFill(startX, startY, fillRGB) {
            const width = canvas.width;
            const height = canvas.height;
            const imageData = ctx.getImageData(0, 0, width, height);
            const data = imageData.data;

            const targetIndex = (startY * width + startX) * 4;
            const targetR = data[targetIndex];
            const targetG = data[targetIndex + 1];
            const targetB = data[targetIndex + 2];
            const targetA = data[targetIndex + 3];

            const fillR = fillRGB.r;
            const fillG = fillRGB.g;
            const fillB = fillRGB.b;

            // 対象色と塗る色がほぼ同じなら無限ループ防止のために処理しない
            if (Math.abs(targetR - fillR) < 2 && Math.abs(targetG - fillG) < 2 && Math.abs(targetB - fillB) < 2 && targetA === 255) {
                return;
            }

            const queue = [{ x: startX, y: startY }];
            const tolerance = 40; // 境界のアンチエイリアスを多少考慮するための許容値

            while (queue.length > 0) {
                const { x, y } = queue.pop();

                let currentY = y;
                while (currentY >= 0 && matchColor(currentY * width + x)) {
                    currentY--;
                }
                currentY++;

                let reachLeft = false;
                let reachRight = false;

                while (currentY < height && matchColor(currentY * width + x)) {
                    const idx = (currentY * width + x) * 4;
                    data[idx] = fillR;
                    data[idx + 1] = fillG;
                    data[idx + 2] = fillB;
                    data[idx + 3] = 255;

                    if (x > 0) {
                        if (matchColor(currentY * width + (x - 1))) {
                            if (!reachLeft) {
                                queue.push({ x: x - 1, y: currentY });
                                reachLeft = true;
                            }
                        } else if (reachLeft) {
                            reachLeft = false;
                        }
                    }

                    if (x < width - 1) {
                        if (matchColor(currentY * width + (x + 1))) {
                            if (!reachRight) {
                                queue.push({ x: x + 1, y: currentY });
                                reachRight = true;
                            }
                        } else if (reachRight) {
                            reachRight = false;
                        }
                    }
                    currentY++;
                }
            }

            function matchColor(pixelIndex) {
                const idx = pixelIndex * 4;
                return Math.abs(data[idx] - targetR) <= tolerance &&
                       Math.abs(data[idx + 1] - targetG) <= tolerance &&
                       Math.abs(data[idx + 2] - targetB) <= tolerance &&
                       Math.abs(data[idx + 3] - targetA) <= tolerance;
            }

            ctx.putImageData(imageData, 0, 0);
        }

        // キャンバス上の相対座標を取得
        function getCanvasCoordinates(e) {
            const rect = canvas.getBoundingClientRect();
            let clientX, clientY;
            if (e.touches && e.touches.length > 0) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else {
                clientX = e.clientX;
                clientY = e.clientY;
            }

            // CSS表示サイズと実際のピクセル数の比率を掛ける
            return {
                x: Math.round((clientX - rect.left) * (canvas.width / rect.width)),
                y: Math.round((clientY - rect.top) * (canvas.height / rect.height))
            };
        }

        // 描画開始 (mousedown / touchstart)
        function startDrawing(e) {
            e.preventDefault();
            saveToHistory();

            isDrawing = true;
            const coords = getCanvasCoordinates(e);
            startX = coords.x;
            startY = coords.y;

            snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);

            // コンテキストの設定
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.lineWidth = penSize;

            if (currentTool === 'pencil') {
                ctx.lineWidth = 1; // 鉛筆は極細1px固定
                ctx.strokeStyle = `rgb(${penColor.r}, ${penColor.g}, ${penColor.b})`;
                ctx.beginPath();
                ctx.moveTo(startX, startY);
                ctx.lineTo(startX, startY);
                ctx.stroke();
            } else if (currentTool === 'brush') {
                ctx.strokeStyle = `rgb(${penColor.r}, ${penColor.g}, ${penColor.b})`;
                ctx.beginPath();
                ctx.moveTo(startX, startY);
                ctx.lineTo(startX, startY);
                ctx.stroke();
            } else if (currentTool === 'eraser') {
                ctx.strokeStyle = '#ffffff'; // 消しゴムは背景色で白塗り
                ctx.beginPath();
                ctx.moveTo(startX, startY);
                ctx.lineTo(startX, startY);
                ctx.stroke();
            } else if (currentTool === 'bucket') {
                floodFill(startX, startY, penColor);
                isDrawing = false; // 塗りつぶしは単一クリックのため即終了
            }
        }

        // 描画中 (mousemove / touchmove)
        function draw(e) {
            const coords = getCanvasCoordinates(e);
            const currentX = coords.x;
            const currentY = coords.y;

            // 座標インジケータ更新
            if (currentX >= 0 && currentX <= canvas.width && currentY >= 0 && currentY <= canvas.height) {
                coordsDisplay.textContent = `${currentX}, ${currentY}px`;
            }

            if (!isDrawing) return;

            // 直線・四角はドラッグ中にスナップショットへ戻してから再描画する
            if (currentTool !== 'pencil' && currentTool !== 'brush' && currentTool !== 'eraser') {
                ctx.putImageData(snapshot, 0, 0);
            }

            ctx.lineWidth = (currentTool === 'pencil') ? 1 : penSize;
            ctx.strokeStyle = (currentTool === 'eraser') ? '#ffffff' : `rgb(${penColor.r}, ${penColor.g}, ${penColor.b})`;

            if (currentTool === 'pencil' || currentTool === 'brush' || currentTool === 'eraser') {
                ctx.lineTo(currentX, currentY);
                ctx.stroke();
            } else if (currentTool === 'line') {
                ctx.beginPath();
                ctx.moveTo(startX, startY);
                ctx.lineTo(currentX, currentY);
                ctx.stroke();
            } else if (currentTool === 'rect') {
                ctx.beginPath();
                ctx.strokeRect(startX, startY, currentX - startX, currentY - startY);
            }
        }

        // 描画終了 (mouseup / touchend)
        function stopDrawing() {
            if (!isDrawing) return;
            isDrawing = false;
            ctx.beginPath();
        }

        // イベント登録 (マウス)
        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mouseleave', () => {
            coordsDisplay.textContent = "0, 0px";
        });

        // イベント登録 (タッチデバイス対応)
        canvas.addEventListener('touchstart', startDrawing, { passive: false });
        canvas.addEventListener('touchmove', draw, { passive: false });
        window.addEventListener('touchend', stopDrawing);

        // 新規作成 (全消去)
        btnNew.addEventListener('click', () => {
            if (confirm('描画中の内容をすべて消去して新規キャンバスを作成しますか？')) {
                saveToHistory();
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }
        });

        // 元に戻す (Undoキーボードショートカット Ctrl+Z / Cmd+Z 対応)
        btnUndo.addEventListener('click', handleUndo);
        window.addEventListener('keydown', (e) => {
            // macOSのCommandキー (metaKey) または Windows/LinuxのCtrlキー (ctrlKey) を判定
            // キーの判定に e.key（小文字・大文字両対応）と、物理キーの e.code === 'KeyZ' を併用して確実に検知します
            if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'z' || e.code === 'KeyZ')) {
                e.preventDefault();
                handleUndo();
            }
        });

        // 保存 (PNGダウンロード)
        btnSave.addEventListener('click', () => {
            try {
                const link = document.createElement('a');
                link.download = `paint-${Date.now()}.png`;
                link.href = canvas.toDataURL('image/png');
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (err) {
                console.error("画像の保存に失敗しました。", err);
            }
        });

        // ローカル画像の読み込み
        imageLoader.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    saveToHistory();
                    
                    // アスペクト比を保ちつつ、キャンバス中央に収まるように描画
                    const canvasAspect = canvas.width / canvas.height;
                    const imgAspect = img.width / img.height;
                    
                    let drawWidth, drawHeight, dx, dy;
                    if (imgAspect > canvasAspect) {
                        drawWidth = canvas.width;
                        drawHeight = canvas.width / imgAspect;
                        dx = 0;
                        dy = (canvas.height - drawHeight) / 2;
                    } else {
                        drawWidth = canvas.height * imgAspect;
                        drawHeight = canvas.height;
                        dx = (canvas.width - drawWidth) / 2;
                        dy = 0;
                    }

                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(img, dx, dy, drawWidth, drawHeight);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });

        // 起動時の初期化
        window.onload = () => {
            initCanvas();
            updateColorFromRGB();
            setBrushSize(10);
        };

        // ウィンドウリサイズ時のレイアウト維持（キャンバスデータ保持）
        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                const backup = ctx.getImageData(0, 0, canvas.width, canvas.height);
                initCanvas();
                ctx.putImageData(backup, 0, 0);
            }, 300);
        });
    </script>
</body>
</html>